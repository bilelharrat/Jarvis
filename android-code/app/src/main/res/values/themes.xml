<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No Material look: the Compose screens draw everything. The window starts on the Eden light. -->
    <style name="Theme.EdenCode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
