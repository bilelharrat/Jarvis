# Copy to .env and edit. Every value is optional.

# Brain. Runs through your Claude Code sign-in; no API key needed.
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low            # low keeps spoken replies quick; medium/high think harder

# Voice (macOS `say`). List voices with: say -v '?'
# For a richer Daniel, download "Daniel (Enhanced)" in System Settings > Accessibility >
# Spoken Content > System voice > Manage Voices, then set JARVIS_VOICE=Daniel (Enhanced).
JARVIS_VOICE=Daniel
JARVIS_SPEECH_RATE=190
JARVIS_ADDRESS=              # e.g. "sir" if you want the full JARVIS treatment

# Ears (local Whisper). tiny.en is faster, small.en is more accurate.
JARVIS_WHISPER_MODEL=base.en
JARVIS_SILENCE_SECONDS=1.2   # pause length that ends your turn

# Calendar that new events go to; blank = the first writable one.
JARVIS_CALENDAR=

# BSH research desk (read-only MCP server). Blank turns it off.
JARVIS_BSH_DIR=~/Investment agent/bsh-research-center

# Claude Code tasks: where project folders live, and how hard the coding agent thinks.
JARVIS_PROJECTS_DIR=~/Investment agent
JARVIS_TASK_EFFORT=high

# Optional cloud voice. Pick a voice in your ElevenLabs or Fish Audio library and paste its
# ID; JARVIS falls back to the Mac voice if the service fails. The in-app "AI voice effect"
# applies to either.
JARVIS_TTS=say                 # say | elevenlabs | fish
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_MODEL=s2.1-pro
