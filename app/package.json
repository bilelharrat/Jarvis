{
  "name": "jarvis-app",
  "productName": "Jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "The Jarvis desktop app: an ambient voice assistant for the Mac.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "node scripts/bake-home.js && electron-packager . Jarvis --platform=darwin --arch=arm64 --out=dist --overwrite --icon=build/icon.icns --extend-info=build/extend-info.plist --app-bundle-id=com.bshventures.jarvis --ignore=^/dist --ignore=^/scripts --ignore=^/build/icon.iconset"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5"
  }
}
